<!-- header -->
<header class="header header--styleOne sticky-on">
    <div id="sticky-placeholder"></div>
    <div class="container container--custom">
        <div class="row">
            <div class="col-12">
                <div class="header__wrapper">
                    <!-- logo start -->
                    <div class="header__logo">
                        <a href="/" class="header__logo__link">
                            <span class="header__logo__image">
                            {{ logo | img_tag: "logo" }}
                            </span>
                        </a>
                    </div>
                    <!-- logo end -->
                    <!-- Main Menu Start -->
                    <div class="header__menu">
                    </div>
                    <!-- Main Menu End -->
                    <!-- Header Right Buttons Search Cart -->
                    <div class="header__right">
                        <nav class="mainMenu">
                            <ul>
                                <li><a href="/">Home</a></li>
                                <li><a href="/collections/all">Catalog</a></li>
                                <li><a href="/contact">Contact</a></li>
                            </ul>
                        </nav>
                    </div>
                    <!-- Header Right Buttons Search Cart -->
                </div>
            </div>
        </div>
    </div>
</header>
<!-- end header -->
<!-- Mobile Menu Navbar -->
<div class="cc cc--slideNav">
    <div class="cc__logo mb-40">
        <a href="/">
            <label class="mean-bar__logo">
                {{ logo | img_tag: "logo" }}
            </label>
        </a>
    </div>
    <div class="offscreen-navigation mb-40">
        <nav class="menu-main-primary-container">
            <ul class="menu">
                <li class="list menu-item-parent menu-item-has-children">
                    <a class="animation" href="/">Home</a>
                </li>
                <li class="list menu-item-parent">
                    <a class="animation" href="/collections/all">Catalog</a>
                </li>
                <li class="list menu-item-parent">
                    <a class="animation" href="/contact">Contact</a>
                </li>
            </ul>
        </nav>
    </div>
</div>
<!-- Mobile Menu Navbar End -->


<!-- Header Style One End -->