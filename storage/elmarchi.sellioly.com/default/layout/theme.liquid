<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">

    {% if page_description %}
        <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <title>{{ page_title }}</title>

    {{ 'animate.min.css' | asset_url | stylesheet_tag }}
    {{ 'custom-animation.css' | asset_url | stylesheet_tag }}
    {{ 'bootstrap.min.css' | asset_url | stylesheet_tag }}
    {{ 'swiper.min.css' | asset_url | stylesheet_tag }}
    {{ 'nice-select.css' | asset_url | stylesheet_tag }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&display=swap"
          rel="stylesheet">
    {{ 'main.css' | asset_url | stylesheet_tag }}
</head>
<body>
<!-- Preloader -->
<div id="preloader">
    <div class="ctn-preloader" id="ctn-preloader">
        <div class="round_spinner">
            <div class="spinner"></div>
            <div class="text">
                {{ logo | img_tag: "logo" }}
            </div>
        </div>
        <h2 class="head">Wait shop loading</h2>
        <p></p>
    </div>
</div>
<!-- Preloader End -->
<main class="main">
    {% include 'sections/header' %}

    {{ content_for_layout }}
</main>

<!-- CURSOR -->
<div class="mouseCursor cursor-outer"></div>
<div class="mouseCursor cursor-inner"></div>
<!-- /CURSOR -->
<script>
    window.shopUrl = '{{ request.origin }}';
</script>
<script src="{{ 'jquery.min.js' | asset_url }}"></script>
<script src="{{ 'bootstrap.bundle.js' | asset_url }}"></script>
<script src="{{ 'swiper.min.js' | asset_url }}"></script>
<script src="{{ 'jquery.nice-select.min.js' | asset_url }}"></script>
<script src="{{ 'validator.min.js' | asset_url }}"></script>
<script src="{{ 'wow.min.js' | asset_url }}"></script>
<script src="{{ 'app.js' | asset_url }}"></script>
</body>
</html>