<section>
    <div class="slick-slider mx-0 slider"
         data-slick-options='{"slidesToShow": 1,"infinite":true,"autoplay":true,"dots":false,"arrows":false,"fade":true,"cssEase":"ease-in-out","speed":600}'>
        {%- for block in section.blocks -%}
            <div class="box px-0">
                <div class="bg-img-cover-center py-12 pt-lg-18 pb-lg-17"
                     style="background-image: url('{{ block.settings.image }}');">
                    <div class="container container-xl py-7">
                        <div class="text-center" style="max-width: 454px" data-animate="fadeInDown">
                            <p class="text-primary fs-56 lh-113 mb-6 custom-font">{{ block.settings.heading }}</p>
                            <h1 class="mb-4 fs-56 lh-128">{{ block.settings.subheading }}</h1>
                            <p class="fs-18 lh-166 mb-7" style="max-width: 454px">{{ block.settings.description }}</p>
                        </div>
                        <div class="text-center" style="max-width: 454px" data-animate="fadeInUp">
                            <a href="{{ block.settings.link }}" class="btn btn-secondary rounded bg-hover-primary border-0">{{ block.settings.button_label }}</a>
                        </div>
                    </div>
                </div>
            </div>
        {%- endfor -%}
    </div>
</section>