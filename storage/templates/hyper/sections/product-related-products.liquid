<!--====== Related Products Start ======-->
{% if section.settings.show %}
<section class="flat-spacing-1 pt_0">
    <div class="container">
        <div class="flat-title">
            <span class="title">{{ section.settings.heading | t }}</span>
        </div>
        <div class="hover-sw-nav hover-sw-2">
            <div dir="ltr" class="swiper tf-sw-product-sell wrap-sw-over swiper-initialized swiper-horizontal swiper-pointer-events swiper-backface-hidden" data-preview="4" data-tablet="3" data-mobile="2" data-space-lg="30" data-space-md="15" data-pagination="2" data-pagination-md="3" data-pagination-lg="3">
                <div class="swiper-wrapper" id="swiper-wrapper-b744ae1481038fb8e" aria-live="polite" style="transform: translate3d(0px, 0px, 0px);">
                    {% for product in similar_products %}
                    <div class="swiper-slide swiper-slide-active" lazy="true" role="group" aria-label="1 / 6" style="width: 337.5px; margin-right: 30px;">
                        {% component 'product-card', product: product, currency: currency %}
                    </div>
                    {% endfor %}

                    <!-- fake products for product preview -->
                    {% if preview %}
                        {% for i in (1..5) %}
                        <div class="swiper-slide height-auto" lazy="true">
                        <div class="card-product style-8">
                            <div class="card-product-wrapper">
                            <a href="#" class="product-img">
                                <img class="img-product ls-is-cached lazyloaded"
                                src="https://sellioly.s3.eu-west-3.amazonaws.com/shared/images/placeholder-images-image_large.webp"
                                data-src="https://sellioly.s3.eu-west-3.amazonaws.com/shared/images/placeholder-images-image_large.webp"
                                alt="image-product">
                                <img class="img-hover ls-is-cached lazyloaded"
                                    data-src="https://sellioly.s3.eu-west-3.amazonaws.com/shared/images/placeholder-images-image_large.webp"
                                    src="https://sellioly.s3.eu-west-3.amazonaws.com/shared/images/placeholder-images-image_large.webp" alt="image-product">
                            </a>
                            </div>
                            <div class="card-product-info text-center">
                            <a href="#" class="title link">Example product</a>
                            <span class="price">299$</span>
                            </div>
                        </div>
                        </div>
                        {% endfor %}

                    {% endif %}
                </div>
            <span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span></div>
            <div class="nav-sw nav-next-slider nav-next-product box-icon w_46 round swiper-button-disabled" tabindex="-1" role="button" aria-label="Previous slide" aria-controls="swiper-wrapper-b744ae1481038fb8e" aria-disabled="true"><span class="icon icon-arrow-left"></span></div>
            <div class="nav-sw nav-prev-slider nav-prev-product box-icon w_46 round" tabindex="0" role="button" aria-label="Next slide" aria-controls="swiper-wrapper-b744ae1481038fb8e" aria-disabled="false"><span class="icon icon-arrow-right"></span></div>
            <div class="sw-dots style-2 sw-pagination-product justify-content-center swiper-pagination-clickable swiper-pagination-bullets swiper-pagination-horizontal"><span class="swiper-pagination-bullet swiper-pagination-bullet-active" tabindex="0" role="button" aria-label="Go to slide 1" aria-current="true"></span><span class="swiper-pagination-bullet" tabindex="0" role="button" aria-label="Go to slide 2"></span></div>
        </div>
    </div>
</section>

{% endif %}

<!--====== Related Products Ends ======-->