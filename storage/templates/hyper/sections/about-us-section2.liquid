{% if section.settings.show %}
<section class="flat-spacing-9">
    <div class="container">
        <div class="flat-title my-0">
            <span class="title"> {{ section.settings.heading }} </span>
            <p class="sub-title text_black-2">
                {{ section.settings.description }}
            </p>
        </div>
    </div>
</section>
{% endif %}