<!-- Marquee -->
{% if section.settings.show %}
<div class="tf-marquee marquee-sm bg_primary not-hover">
    <div class="wrap-marquee">
        {% for n in (1..3) %}
        <div class="marquee-item">
            <div class="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="7" height="6" viewBox="0 0 7 6" fill="none">
                    <path d="M3.5 0L6.53109 5.25H0.468911L3.5 0Z" fill="black"></path>
                </svg>
            </div>
            <p class="text text-uppercase fw-6">{{ section.settings.text_1 }}</p>
        </div>
        <div class="marquee-item">
            <div class="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="7" height="6" viewBox="0 0 7 6" fill="none">
                    <path d="M3.5 0L6.53109 5.25H0.468911L3.5 0Z" fill="black"></path>
                </svg>
            </div>
            <p class="text text-uppercase fw-6">{{ section.settings.text_2 }}</p>
        </div>
        <div class="marquee-item">
            <div class="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="7" height="6" viewBox="0 0 7 6" fill="none">
                    <path d="M3.5 0L6.53109 5.25H0.468911L3.5 0Z" fill="black"></path>
                </svg>
            </div>
            <p class="text text-uppercase fw-6">{{ section.settings.text_3 }}</p>
        </div>
        {% endfor %}
    </div>

</div>
{% endif %}
<!-- /Marquee -->