{% if section.settings.show %}
<div class="tf-slideshow slider-home-2 slider-effect-fade position-relative">
  <div class="swiper tf-sw-slideshow" data-preview="1" data-tablet="1" data-mobile="1" data-centered="false"
    data-space="0" data-loop="true" data-auto-play="true" data-delay="2000" data-speed="1000">
    <div class="swiper-wrapper">
      <div class="swiper-slide" lazy="true">
        <div class="wrap-slider">
          <img class="lazyload"
            data-src="{{ section.blocks[0].settings.image }}"
            src="{{ section.blocks[0].settings.image }}"
            alt="fashion-slideshow-01" />
          <div class="box-content" style="text-align: {{ section.blocks[0].settings.text_align }}">
            <div class="container">
              <p class="fade-item fade-item-1" style="color: {{ section.blocks[0].settings.text_color }}">{{ section.blocks[0].settings.subheading }}</p>
              <h1 class="fade-item fade-item-2" style="color: {{ section.blocks[0].settings.text_color }}">{{ section.blocks[0].settings.heading }}</h1>
              <a href="{{ section.blocks[0].settings.button_link }}"
                style="color: {{ section.blocks[0].settings.btn_text_color }}; background-color: {{ section.blocks[0].settings.btn_bg_color }}; border-color: {{ section.blocks[0].settings.btn_bg_color }}"
                class="fade-item fade-item-3 rounded-full tf-btn btn-fill animate-hover-btn btn-xl radius-3"><span>
                    {{ section.blocks[0].settings.button_label }}
                  </span><i class="icon icon-arrow-right"></i></a>
            </div>
          </div>
        </div>
      </div>
      <div class="swiper-slide" lazy="true">
        <div class="wrap-slider">
          <img class="lazyload"
            data-src="{{ section.blocks[1].settings.image }}"
            src="{{ section.blocks[1].settings.image }}"
            alt="fashion-slideshow-01">
          <div class="box-content" style="text-align: {{ section.blocks[0].settings.text_align }}">
            <div class="container">
              <p class="fade-item fade-item-1" style="color: {{ section.blocks[1].settings.text_color }}">{{ section.blocks[1].settings.subheading }}</p>
              <h1 class="fade-item fade-item-2" style="color: {{ section.blocks[1].settings.text_color }}">{{ section.blocks[1].settings.heading }}</h1>
              <a href="{{ section.blocks[1].settings.button_link }}"
                style="color: {{ section.blocks[1].settings.btn_text_color }}; background-color: {{ section.blocks[1].settings.btn_bg_color }}; border-color: {{ section.blocks[1].settings.btn_bg_color }}"
                class="fade-item fade-item-3 rounded-full tf-btn btn-fill animate-hover-btn btn-xl radius-3"><span>
                  {{ section.blocks[1].settings.button_label }}
                </span><i class="icon icon-arrow-right"></i></a>
            </div>
          </div>
        </div>
      </div>
      <div class="swiper-slide" lazy="true">
        <div class="wrap-slider">
          <img class="lazyload"
            data-src="{{ section.blocks[2].settings.image }}"
            src="{{ section.blocks[2].settings.image }}"
            alt="fashion-slideshow-01">
          <div class="box-content" style="text-align: {{ section.blocks[0].settings.text_align }}">
            <div class="container">
              <p class="fade-item fade-item-1" style="color: {{ section.blocks[2].settings.text_color }}">{{ section.blocks[2].settings.subheading }}</p>
              <h1 class="fade-item fade-item-2" style="color: {{ section.blocks[2].settings.text_color }}">{{ section.blocks[2].settings.heading }}</h1>
              <a href="{{ section.blocks[2].settings.button_link }}"
                style="color: {{ section.blocks[2].settings.btn_text_color }}; background-color: {{ section.blocks[2].settings.btn_bg_color }}; border-color: {{ section.blocks[2].settings.btn_bg_color }}"
                class="fade-item fade-item-3 rounded-full tf-btn btn-fill animate-hover-btn btn-xl radius-3"><span>
                  {{ section.blocks[2].settings.button_label }}
                  </span><i class="icon icon-arrow-right"></i></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="wrap-pagination sw-absolute-2">
    <div class="container">
      <div class="sw-dots sw-pagination-slider justify-content-center"></div>
    </div>
  </div>
</div>
{% endif %}