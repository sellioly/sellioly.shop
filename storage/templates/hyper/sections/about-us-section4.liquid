{% if section.settings.show %}
<section class="flat-testimonial-v2 flat-spacing-24">
    <div class="container">
        <div class="wrapper-thumbs-testimonial-v2 flat-thumbs-testimonial">
            <div class="box-left">
                <div dir="ltr" class="swiper tf-sw-tes-2 swiper-initialized swiper-horizontal swiper-pointer-events swiper-backface-hidden" data-preview="1" data-space-lg="40" data-space-md="30">
                    <div class="swiper-wrapper" id="swiper-wrapper-7e4cb9954c5f0855" aria-live="polite" style="transform: translate3d(0px, 0px, 0px); transition-duration: 0ms;">
                        <div class="swiper-slide swiper-slide-active" role="group" aria-label="1 / 2" style="width: 660px; margin-right: 40px;">
                            <div class="testimonial-item lg lg-2">
                                <h4 class="mb_40">{{ section.blocks[0].settings.heading }}</h4>
                                <div class="icon">
                                    <img class=" ls-is-cached lazyloaded"  data-src="https://themesflat.co/html/ecomus/images/item/quote.svg" alt="" src="https://themesflat.co/html/ecomus/images/item/quote.svg">
                                </div>
                                <div class="rating">
                                    {% assign nbStars = section.blocks[0].settings.stars | plus: 0 %}
                                    {% for i in (1..5) %}
                                        {% if i <= nbStars %}
                                            <i class="icon-star"></i>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                <p class="text">
                                    {{ section.blocks[0].settings.review }}
                                </p>
                                <div class="author box-author">
                                    <div class="box-img d-md-none rounded-0">
                                        <img class="lazyload img-product" data-src="{{ section.blocks[0].settings.image_url }}" src="{{ section.blocks[0].settings.image_url }}" alt="image-product">
                                    </div>
                                    <div class="content">
                                        <div class="name">{{ section.blocks[0].settings.author }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="swiper-slide swiper-slide-next" role="group" aria-label="2 / 2" style="width: 660px; margin-right: 40px;">
                            <div class="testimonial-item lg lg-2">
                                <h4 class="mb_40">{{ section.blocks[1].settings.heading }}</h4>
                                <div class="icon">
                                    <img class=" ls-is-cached lazyloaded"  data-src="https://themesflat.co/html/ecomus/images/item/quote.svg" alt="" src="https://themesflat.co/html/ecomus/images/item/quote.svg">
                                </div>
                                <div class="rating">
                                    {% assign nbStars = section.blocks[1].settings.stars | plus: 0 %}
                                    {% for i in (1..5) %}
                                        {% if i <= nbStars %}
                                            <i class="icon-star"></i>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                <p class="text">
                                    {{ section.blocks[1].settings.review }}
                                </p>
                                <div class="author box-author">
                                    <div class="box-img d-md-none rounded-0">
                                        <img class="lazyload img-product" data-src="{{ section.blocks[1].settings.image_url }}" src="{{ section.blocks[1].settings.image_url }}" alt="image-product">
                                    </div>
                                    <div class="content">
                                        <div class="name">{{ section.blocks[1].settings.author }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span></div>
                <div class="d-md-flex d-none box-sw-navigation">
                    <div class="nav-sw nav-next-slider nav-next-tes-2 swiper-button-disabled" tabindex="-1" role="button" aria-label="Previous slide" aria-controls="swiper-wrapper-7e4cb9954c5f0855" aria-disabled="true"><span class="icon icon-arrow-left"></span></div>
                    <div class="nav-sw nav-prev-slider nav-prev-tes-2" tabindex="0" role="button" aria-label="Next slide" aria-controls="swiper-wrapper-7e4cb9954c5f0855" aria-disabled="false"><span class="icon icon-arrow-right"></span></div>
                </div>
                <div class="d-md-none sw-dots style-2 sw-pagination-tes-2 swiper-pagination-clickable swiper-pagination-bullets swiper-pagination-horizontal"><span class="swiper-pagination-bullet swiper-pagination-bullet-active" tabindex="0" role="button" aria-label="Go to slide 1" aria-current="true"></span><span class="swiper-pagination-bullet" tabindex="0" role="button" aria-label="Go to slide 2"></span></div>
            </div>
            <div class="box-right">
                <div dir="ltr" class="swiper tf-thumb-tes swiper-initialized swiper-horizontal swiper-pointer-events swiper-backface-hidden" data-preview="1" data-space="30">
                    <div class="swiper-wrapper" id="swiper-wrapper-dd696b82a96b01fe" aria-live="polite" style="transform: translate3d(0px, 0px, 0px); transition-duration: 0ms;">
                        <div class="swiper-slide swiper-slide-active" role="group" aria-label="1 / 2" style="width: 720px; margin-right: 30px;">
                            <div class="img-sw-thumb">
                                <img class="img-product ls-is-cached lazyloaded" data-src="{{ section.blocks[0].settings.image_url }}" src="{{ section.blocks[0].settings.image_url }}" alt="image-product">
                            </div>
                        </div>
                        <div class="swiper-slide swiper-slide-next" role="group" aria-label="2 / 2" style="width: 720px; margin-right: 30px;">
                            <div class="img-sw-thumb">
                                <img class="img-product ls-is-cached lazyloaded" data-src="{{ section.blocks[1].settings.image_url }}" src="{{ section.blocks[1].settings.image_url }}" alt="image-product">
                            </div>
                        </div>
                    </div>
                <span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span></div>
            </div>
        </div>
    </div>
</section>
{% endif %}