{% unless preview %}
<div class="tf-breadcrumb">
    <div class="container">
        <div class="tf-breadcrumb-wrap d-flex justify-content-between flex-wrap align-items-center">
            <div class="tf-breadcrumb-list">
                <a href="/" class="text">{{ 'common.home' | t }}</a>
                <i class="icon icon-arrow-right"></i>
                <a href="/collections/{{ product.collection.handle }}" class="text">{{ product.collection.title }}</a>
                <i class="icon icon-arrow-right"></i>
                <span class="text">{{ product.title }}</span>
            </div>
        </div>
    </div>
</div>
<!-- /breadcrumb -->
<!-- default -->
<section class="flat-spacing-4 pt_0">
    <div class="tf-main-product">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <div class="tf-product-media-wrap sticky-top">
                        <div class="thumbs-slider thumbs-default">
                            <div class="swiper tf-product-media-thumbs tf-product-media-thumbs-default swiper-initialized swiper-vertical swiper-pointer-events swiper-free-mode swiper-watch-progress swiper-backface-hidden swiper-thumbs" data-direction="vertical">
                                <div class="swiper-wrapper stagger-wrap" id="swiper-wrapper-79da9e28e43710929" aria-live="polite" style="transform: translate3d(0px, 0px, 0px); transition-duration: 0ms;">
                                    {% for image in product.images %}
                                    <div class="swiper-slide stagger-item stagger-finished swiper-slide-visible swiper-slide-active" role="group" aria-label="1 / 3" style="transition-delay: 0.2s; margin-bottom: 10px;">
                                        <div class="item">
                                            <img class=" ls-is-cached lazyloaded" data-src="{{ image.src }}" src="{{ image.src }}" alt="">
                                        </div>
                                    </div>
                                    {% endfor %}
                                </div>
                            <span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span></div>
                            <div class="swiper tf-product-media-main tf-product-media-main-default swiper-initialized swiper-horizontal swiper-pointer-events swiper-backface-hidden">
                                <div class="swiper-wrapper" id="swiper-wrapper-4b9c184cecaf1f70" aria-live="polite" style="transform: translate3d(-1212px, 0px, 0px); transition-duration: 0ms;">
                                    {% for image in product.images %}
                                    <div class="swiper-slide" role="group" aria-label="1 / 3" style="width: 606px;">
                                        <a href="#" class="item">
                                            <img class=" ls-is-cached lazyloaded" data-src="{{ image.src }}" src="{{ image.src }}" alt="">
                                        </a>
                                    </div>
                                    {% endfor %}
                                </div>
                                <div class="swiper-button-next button-style-arrow thumbs-next swiper-button-disabled" tabindex="-1" role="button" aria-label="Next slide" aria-controls="swiper-wrapper-4b9c184cecaf1f70" aria-disabled="true"></div>
                                <div class="swiper-button-prev button-style-arrow thumbs-prev" tabindex="0" role="button" aria-label="Previous slide" aria-controls="swiper-wrapper-4b9c184cecaf1f70" aria-disabled="false"></div>
                            <span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    {% if presets.cart.settings.product_form_type == 'add-to-cart' %}
                    <add-to-cart-form>
                    {% elsif presets.cart.settings.product_form_type == 'buy-now' %}
                    <buy-now-form>
                    {% elsif presets.cart.settings.product_form_type == 'order-now' %}
                    <order-now-form>
                    {% endif %}

                    <!-------------- selected variant ------------>
                    <input hidden id="variant-id" type="text" name="variant_id" value="{{ product.variants[0].id }}">

                    <div class="tf-product-info-wrap position-relative">
                        <div class="tf-zoom-main"></div>
                        <div class="tf-product-info-list">
                            <div class="tf-product-info-title">
                                <h5>{{ product.title }}</h5>
                            </div>

                            {% if product.variants[0].price %}
                            <div class="tf-product-info-price">
                                <div class="price-on-sale">
                                    <span id="product-price">{{ product.variants[0].price }}</span>
                                    <span class="ml-1"> {{ currency }}</span>
                                </div>
                            </div>
                            {% endif %}

                            <div class="tf-product-info-variant-picker">
                                {% for option in product.options %}
                                <div class="variant-picker-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="variant-picker-label">
                                            {{ option.name }}:
                                        </div>
                                    </div>
                                    <variant-options-radio>
                                        <div class="variant-picker-values">
                                            {% for value in option.values %}
                                            <input type="radio" name="{{ option.name }}" id="{{ option.name }}-{{ value }}" value="{{ value }}" {% if forloop.first %} checked {% endif %}>
                                            <label class="style-text" for="{{ option.name }}-{{ value }}" data-value="{{ value }}">
                                                <p>{{ value }}</p>
                                            </label>
                                            {% endfor %}
                                        </div>
                                    </variant-options-radio>
                                </div>
                                {% endfor %}
                            </div>

                            <div class="tf-product-info-quantity">
                                <div class="quantity-title fw-6">Quantity</div>
                                <div class="wg-quantity">
                                    <span class="btn-quantity minus-btn">-</span>
                                    <input type="text" id="product-quantity" name="quantity" value="1">
                                    <span class="btn-quantity plus-btn">+</span>
                                </div>
                            </div>
                            <div class="tf-product-info-buy-button">
                                {% if presets.cart.settings.product_form_type == 'add-to-cart' %}
                                <button class="tf-btn btn-fill justify-content-center fw-6 fs-16 flex-grow-1 animate-hover-btn btn-add-to-cart w-100" type="submit">{{ 'product.add_to_cart' | t }}</button>
                                {% elsif presets.cart.settings.product_form_type == 'buy-now' %}
                                <button class="tf-btn btn-fill justify-content-center fw-6 fs-16 flex-grow-1 animate-hover-btn btn-add-to-cart" type="submit">{{ 'product.buy_now' | t }}</button>
                                {% elsif presets.cart.settings.product_form_type == 'order-now' %}
                                <div id="order-now-form" style="width: 100%">
                                    <div style="border-top: 0.1rem solid #ebebeb;width: 100%;"></div>

                                    <div class="row">
                                        <div class="col-sm-12" speechify-initial-font-family="Poppins, sans-serif" speechify-initial-font-size="16px">
                                            <div class="single-form" speechify-initial-font-family="Poppins, sans-serif" speechify-initial-font-size="16px">
                                                <input placeholder="{{ 'common.fullname' | t }}" required="" type="text" name="full_name" data-dashlane-rid="3ce88877bcb2f9e0" data-form-type="other" speechify-initial-font-family="Poppins, sans-serif" speechify-initial-font-size="14px">
                                            </div>
                                        </div>
                                        <div class="col-sm-12" speechify-initial-font-family="Poppins, sans-serif" speechify-initial-font-size="16px">
                                            <div class="single-form" speechify-initial-font-family="Poppins, sans-serif" speechify-initial-font-size="16px">
                                                <input placeholder="{{ 'common.phone' | t }}" required="" type="tel" name="phone" data-dashlane-rid="c67f59a8dbc4d8ce" data-form-type="other" speechify-initial-font-family="Poppins, sans-serif" speechify-initial-font-size="14px">
                                            </div>
                                        </div>
                                        <div class="col-sm-12" speechify-initial-font-family="Poppins, sans-serif" speechify-initial-font-size="16px">
                                            <div class="single-form" speechify-initial-font-family="Poppins, sans-serif" speechify-initial-font-size="16px">
                                                <input placeholder="{{ 'common.city' | t }}" required="" type="text" name="city" data-dashlane-rid="94f402015160ff0c" data-form-type="other" speechify-initial-font-family="Poppins, sans-serif" speechify-initial-font-size="14px">
                                            </div>
                                        </div>
                                        <div class="col-sm-12" speechify-initial-font-family="Poppins, sans-serif" speechify-initial-font-size="16px">
                                            <div class="single-form" speechify-initial-font-family="Poppins, sans-serif" speechify-initial-font-size="16px">
                                                <textarea name="address" placeholder="{{ 'common.address' | t }}" data-dashlane-rid="3065a8f2346b8cdf" data-form-type="other" speechify-initial-font-family="Poppins, sans-serif" speechify-initial-font-size="14px"></textarea>
                                            </div>
                                        </div>

                                        <div class="col-sm-12 mt-20">
                                            <button style="width: 100%" class="tf-btn btn-fill justify-content-center fw-6 fs-16 flex-grow-1 animate-hover-btn btn-add-to-cart" type="submit">{{ 'product.order_now' | t }}</button>
                                        </div>
                                    </div>

                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    {% if presets.cart.settings.product_form_type == 'add-to-cart' %}
                    </add-to-cart-form>
                    {% elsif presets.cart.settings.product_form_type == 'buy-now' %}
                    </buy-now-form>
                    {% elsif presets.cart.settings.product_form_type == 'order-now' %}
                    </order-now-form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
<!-- /default -->
<!-- tabs -->
<section class="flat-spacing-17 pt_0">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="widget-tabs style-has-border">
                    <ul class="widget-menu-tab">
                        <li class="item-title active">
                            <span class="inner">Description</span>
                        </li>
                    </ul>
                    <div class="widget-content-tab">
                        <div class="widget-content-inner active">
                            <div class="">
                                {% if product.body_html %}
                                    {{ product.body_html }}
                                {% else %}
                                    <p class="text-center">There is no description for this product</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endunless %}

