<!-- Testimonial -->
{% if section.settings.show %}
<section class="flat-spacing-18 flat-testimonial bg_grey-7">
    <div class="container">
        <div class="flat-title wow fadeInUp" data-wow-delay="0s">
            <span class="title">{{ section.settings.heading }}</span>
            <p class="sub-title">{{ section.settings.subheading }}</p>
        </div>
        <div class="wrap-carousel">
            <div class="swiper tf-sw-testimonial" data-preview="3" data-tablet="2" data-mobile="1" data-space-lg="30"
                data-space-md="15">
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                    <div class="swiper-slide height-auto">
                        <div class="testimonial-item h-100 bg_white style-column wow fadeInUp" data-wow-delay="0s">
                            <div class="rating">
                                {% assign nbStars = block.settings.stars | plus: 0 %}
                                {% for i in (1..5) %}
                                    {% if i <= nbStars %}
                                        <i class="icon-start text_primary"></i>
                                    {% endif %}
                                {% endfor %}
                            </div>
                            <div class="heading">{{ block.settings.client_name }}</div>
                            <div class="text">
                                “ {{ block.settings.text }} ”
                            </div>
                            {% if block.settings.product %}
                                <div class="product">
                                    <div class="image">
                                        <a href="product-detail.html">
                                            <img class="lazyload"
                                                data-src="{{ block.settings.product.default_image.src }}"
                                                src="{{ block.settings.product.default_image.src }}"
                                                alt="">
                                        </a>
                                    </div>
                                    <div class="content-wrap">
                                        <div class="product-title">
                                            <a href="product-detail.html">
                                                {{ block.settings.product.title }}
                                            </a>
                                        </div>
                                        <div class="price">{{ block.settings.product.variants[0].price }} {{ currency }}</div>
                                    </div>
                                    <a href="product-detail.html" class=""><i class="icon-arrow1-top-left"></i></a>
                                </div>
                            {% else %}
                                <div class="product">
                                    <div class="image">
                                        <a href="product-detail.html">
                                            <img class="lazyload"
                                                data-src="https://sellioly.s3.eu-west-3.amazonaws.com/shared/images/placeholder-images-image_large.webp"
                                                src="https://sellioly.s3.eu-west-3.amazonaws.com/shared/images/placeholder-images-image_large.webp"
                                                alt="">
                                        </a>
                                    </div>
                                    <div class="content-wrap">
                                        <div class="product-title">
                                            <a href="product-detail.html">
                                                Product Name
                                            </a>
                                        </div>
                                        <div class="price">199.00 {{ currency }}</div>
                                    </div>
                                    <a href="product-detail.html" class=""><i class="icon-arrow1-top-left"></i></a>
                                </div>                            
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            <div class="nav-sw nav-next-slider nav-next-testimonial lg"><span class="icon icon-arrow-left"></span></div>
            <div class="nav-sw nav-prev-slider nav-prev-testimonial lg"><span class="icon icon-arrow-right"></span>
            </div>
            <div class="sw-dots style-2 sw-pagination-testimonial justify-content-center"></div>
        </div>
    </div>
</section>
{% endif %}
<!-- /Testimonial -->