<div class="page-header text-center" style="background-color: #eeeeee66">
    <div class="container">
        <h1 class="page-title">Shopping Cart<span>Shop</span></h1>
    </div><!-- End .container -->
</div><!-- End .page-header -->
<nav aria-label="breadcrumb" class="breadcrumb-nav">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Shopping Cart</li>
        </ol>
    </div><!-- End .container -->
</nav><!-- End .breadcrumb-nav -->

<div class="page-content">
    <div class="cart">
        <div class="container">
            {% if cart.items.size > 0 %}
                <div class="row">
                    <div class="col-lg-9">
                        <table class="table table-cart table-mobile">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody data-dashlane-rid="e3d12b1d5faa340a" data-form-type="other">
                                {% for item in cart.items %}
                                    <tr id="cart-item-{{ item.variant_id }}">
                                        <td class="product-col">
                                            <div class="product">
                                                <figure class="product-media">
                                                    <a href="#">
                                                        <img src="{{ item.image }}" alt="Product image">
                                                    </a>
                                                </figure>
                                                <div>
                                                    <h3 class="product-title">
                                                        <a href="#">{{ item.title }}</a>
                                                    </h3><!-- End .product-title -->

                                                    {% if item.options.size > 0 %}
                                                        <p>
                                                        {% for option in item.options %}
                                                            <span class="">{{ option.name }}</span>:
                                                            <span class="">{{ option.value }}</span>
                                                            {% unless forloop.last %}
                                                            <span class="">,
                                                            </span>
                                                            {% endunless %}
                                                        {% endfor %}
                                                        </p>
                                                    {% endif %}
                                                    

                                                </div>
                                            </div><!-- End .product -->
                                        </td>
                                        <td class="price-col">{{ item.price }} {{ currency }}</td>
                                        <td class="quantity-col">
                                            <div class="cart-product-quantity">
                                                <update-cart-quantity-form>
                                                    <input hidden type="number" name="variant_id" value="{{ item.variant_id }}">

                                                    <input
                                                        name="quantity"
                                                        type="number"
                                                        class="quantity form-control"
                                                        value="{{ item.quantity }}"
                                                        min="1"
                                                        max="10"
                                                        step="1"
                                                        data-decimals="0"
                                                        required
                                                    />
                                                </update-cart-quantity-form>
                                            </div>
                                            <!-- End .cart-product-quantity -->
                                        </td>
                                        <td class="total-col"><span data-id="total-product-price">{{ item.price | times: item.quantity }}</span> {{ currency }}</td>
                                        <td class="remove-col">
                                            <remove-from-cart-form>
                                                <!-------------- variant id ------------>
                                                <input hidden type="number" name="variant_id" value="{{ item.variant_id }}">

                                                <button class="btn-remove" type="submit" data-dashlane-rid="22c5497bde86aa1e" data-dashlane-label="true" data-form-type="other">
                                                    <i class="icon-close"></i>
                                                </button>
                                            </remove-from-cart-form>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table><!-- End .table table-wishlist -->

                    </div><!-- End .col-lg-9 -->
                    <aside class="col-lg-3">
                        <div class="summary summary-cart">
                            <h3 class="summary-title">Cart Total</h3><!-- End .summary-title -->

                            <table class="table table-summary">
                                <tbody>
                                    <tr class="summary-subtotal">
                                        <td>Subtotal:</td>
                                        <td><span data-id="subtotal-price">{{ cart.subtotal }}</span> {{ currency }}</td>
                                    </tr><!-- End .summary-subtotal -->

                                    <tr class="summary-total">
                                        <td>Total:</td>
                                        <td><span data-id="total-price">{{ cart.subtotal }}</span> {{ currency }}</td>
                                    </tr><!-- End .summary-total -->
                                </tbody>
                            </table><!-- End .table table-summary -->

                            <a href="/checkout" class="btn btn-outline-primary-2 btn-order btn-block">PROCEED TO CHECKOUT</a>
                        </div><!-- End .summary -->

                        <a href="/collections/all" class="btn btn-outline-dark-2 btn-block mb-3"><span>CONTINUE SHOPPING</span><i class="icon-refresh"></i></a>
                    </aside><!-- End .col-lg-3 -->
                </div><!-- End .row -->
            {% else %}
                <div class="text-center my-5">
                    <p class="mb-1" style="font-size: 18px">No Items in the cart</p>
                    <a href="/collections/all" class="btn btn-outline-primary-2 btn-minwidth-lg">
                        <span>GO TO SHIPPING</span>
                        <i class="icon-long-arrow-right"></i>
                    </a>
                </div>
            {% endif %}
        </div><!-- End .container -->
    </div><!-- End .cart -->
</div><!-- End .page-content -->