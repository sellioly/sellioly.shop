{
  "name": "Slidshow",
  "settings": {
    "show": {
      "element": "checkbox",
      "label": "Show section",
      "default": true
    },
    "divider_1": {
      "element": "divider"
    },
    "text_align": {
      "element": "select",
      "label": "Text position",
      "options": [
        {
          "label": "Left",
          "value": "text-left"
        },
        {
          "label": "Center",
          "value": "text-center"
        },
        {
          "label": "Right",
          "value": "text-right"
        }
      ],
      "default": "text-left"
    }
  },
  "blocks": {
    "slide": {
      "name": "Slide item",
      "settings": {
        "subheading": {
          "element": "text",
          "label": "Heading",
          "default": "summer collection"
        },
        "heading": {
          "element": "text",
          "label": "Heading",
          "default": "new summer <br/>collection 2023"
        },
        "button_label": {
          "element": "text",
          "label": "Text",
          "default": "Discover more"
        },
        "button_link": {
          "element": "url",
          "label": "Link",
          "default": "#"
        },
        "image": {
          "element": "image-picker",
          "label": "Image",
          "default": "https://sellioly.s3.eu-west-3.amazonaws.com/partners/23372036854776000/images/banner-1-3.jpg"
        }
      }
    }
  }
}